local function getDelay(box)
    return math.max(tonumber(box.Text) or 0.2, 0.05)
end

-- ===== ปุ่มสวิตช์ =====
local ON_COLOR  = Color3.fromRGB(46, 160, 90)
local OFF_COLOR = Color3.fromRGB(70, 70, 85)

local function makeToggle(text, y, onChange)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 34)
    btn.Position = UDim2.new(0, 10, 0, y)
    btn.BorderSizePixel = 0
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.Parent = body
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local state = false
    local function render()
        btn.Text = text .. ": " .. (state and "เปิด" or "ปิด")
        btn.BackgroundColor3 = state and ON_COLOR or OFF_COLOR
    end
    render()

    btn.MouseButton1Click:Connect(function()
        state = not state
        render()
        onChange(state)
    end)
    return btn
end

