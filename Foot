local function refresh()
    local s = string.format("ซื้อแล้ว: %d | เปิดแล้ว: %d", buyCount, openCount)
    if lastErr ~= "" then s = s .. "\n" .. lastErr end
    status.Text = s
end
refresh()

-- ===== ฟังก์ชัน: ซื้อกุญแจ =====
makeToggle("ซื้อกุญแจ", 194, function(state)
    buyOn = state
    buyToken += 1
    if not state then return end
    local myToken = buyToken
    task.spawn(function()
        while buyOn and myToken == buyToken do
            local ok1, res = pcall(function()
                return BuyKey:InvokeServer(keyBox.Text, tonumber(amountBox.Text) or 1)
            end)
            if ok1 then
                buyCount += 1
            else
                lastErr = "ซื้อ error: " .. tostring(res)
            end
            refresh()
            task.wait(getDelay(buyDelayBox))
        end
    end)
end)

-- ===== ฟังก์ชัน: สุ่มผล (เปิดหีบ) =====
makeToggle("สุ่มผล (เปิด)", 230, function(state)
    openOn = state
    openToken += 1
    if not state then return end
    local myToken = openToken
    task.spawn(function()
        while openOn and myToken == openToken do
            local ok2, res = pcall(function()
                return UseKey:InvokeServer(keyBox.Text, modeBtn.Text)
            end)
            if ok2 then
                openCount += 1
            else
                lastErr = "เปิด error: " .. tostring(res)
            end
            refresh()
            task.wait(getDelay(openDelayBox))
        end
    end)
end)

-- ===== ลากหน้าต่าง (รองรับมือถือ) =====
do
    local dragging, dragStart, startPos
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

